<Window x:Class="Orfelin.WPF.KnjigaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knjiga" Height="635" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtNaslovDijaloga" Text="Dodaj knjigu" FontSize="20" 
                   FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Naslov" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNaslov" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Autor" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAutor" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="ISBN" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtISBN" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Žanr" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtZanr" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Godina izdavanja" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtGodina" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Ukupan broj kopija" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUkupno" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Dostupno kopija" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDostupno" Height="35" Padding="10,8"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnOtkazi" Content="Otkaži" Padding="15,8" Margin="0,0,10,0"
                    Background="#95A5A6" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnOtkazi_Click"/>
            <Button x:Name="btnSacuvaj" Content="Sačuvaj" Padding="15,8"
                    Background="#27AE60" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>