<Window x:Class="Orfelin.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orfelin – Biblioteka" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Levi meni -->
        <StackPanel Grid.Column="0" Background="#2C3E50">

            <TextBlock Text="ORFELIN" FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,30,0,5"/>

            <TextBlock x:Name="txtKorisnik" FontSize="11" Foreground="#BDC3C7"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Button x:Name="btnKnjige" Content="📚 Knjige" Style="{StaticResource MenuButton}"
                    Click="btnKnjige_Click"/>

            <Button x:Name="btnCitaoci" Content="👤 Čitaoci" Style="{StaticResource MenuButton}"
                    Click="btnCitaoci_Click"/>

            <Button x:Name="btnPozajmice" Content="📋 Pozajmice" Style="{StaticResource MenuButton}"
                    Click="btnPozajmice_Click"/>

            <Button x:Name="btnZaposleni" Content="👥 Zaposleni" Style="{StaticResource MenuButton}"
                    Click="btnZaposleni_Click" Visibility="Collapsed"/>

            <Button x:Name="btnOdjava" Content="🚪 Odjava" Style="{StaticResource MenuButton}"
                    Click="btnOdjava_Click" VerticalAlignment="Bottom" Margin="0,300,0,0"/>
        </StackPanel>

        <!-- Desni sadržaj -->
        <Frame x:Name="mainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>