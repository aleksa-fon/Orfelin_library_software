<Window x:Class="Orfelin.WPF.PozajmicaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova pozajmica" Height="391" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nova pozajmica" FontSize="20"
                   FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Čitalac" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbKorisnik" Height="35" Margin="0,0,0,10"
                      DisplayMemberPath="Ime"/>

            <TextBlock Text="Knjiga" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbKnjiga" Height="35" Margin="0,0,0,10"
                      DisplayMemberPath="Naslov"/>

            <TextBlock Text="Rok vraćanja" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpRokVracanja" Height="35" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Otkaži" Padding="15,8" Margin="0,0,10,0"
                    Background="#95A5A6" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnOtkazi_Click"/>
            <Button Content="Izdaj" Padding="15,8"
                    Background="#27AE60" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>