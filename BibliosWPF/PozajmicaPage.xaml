<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="Orfelin.WPF.PozajmicaPage"
      Title="Pozajmice" Loaded="Page_Loaded" av:DesignWidth="553.441" av:DesignHeight="355.42">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Pozajmice" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <Button x:Name="btnDodaj" Content="+ Nova pozajmica" HorizontalAlignment="Right"
                    Background="#27AE60" Foreground="White" Padding="15,8"
                    BorderThickness="0" Cursor="Hand" Click="btnDodaj_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBox x:Name="txtPretraga" Height="35" Padding="10,8" FontSize="13"
                     BorderBrush="#BDC3C7" BorderThickness="1"
                     TextChanged="txtPretraga_TextChanged"/>
            <TextBlock Text="Pretraži pozajmice..." Foreground="#BDC3C7" FontSize="13"
                       Padding="12,8" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtPretraga}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <DataGrid x:Name="dgPozajmice" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  BorderBrush="#BDC3C7" BorderThickness="1"
                  RowBackground="White" AlternatingRowBackground="#F9F9F9"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Korisnik" Binding="{Binding Korisnik.Ime}" Width="120"/>
                <DataGridTextColumn Header="Knjiga" Binding="{Binding Knjiga.Naslov}" Width="*"/>
                <DataGridTextColumn Header="Datum pozajmice" Binding="{Binding DatumPozajmice, StringFormat=dd.MM.yyyy}" Width="130"/>
                <DataGridTextColumn Header="Rok vraćanja" Binding="{Binding RokVracanja, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Vraćeno" Binding="{Binding DatumVracanja, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnVrati" Content="✅ Razduži" Padding="15,8" Margin="0,0,10,0"
                    Background="#27AE60" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnVrati_Click"/>
            <Button x:Name="btnObrisi" Content="🗑️ Obriši" Padding="15,8"
                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnObrisi_Click"/>
        </StackPanel>
    </Grid>
</Page>