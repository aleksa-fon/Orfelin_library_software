<Window x:Class="Orfelin.WPF.ZaposleniDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zaposleni" Height="522" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtNaslovDijaloga" Text="Dodaj zaposlenog" FontSize="20"
                   FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Ime" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtIme" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Prezime" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPrezime" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Username" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Height="35" Padding="10,8" Margin="0,0,0,10"
                     BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Lozinka" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtLozinka" Height="35" Padding="10,8" Margin="0,0,0,10"
                         BorderBrush="#BDC3C7" BorderThickness="1"/>

            <TextBlock Text="Uloga" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbUloga" Height="35" Margin="0,0,0,10">
                <ComboBoxItem Content="Bibliotekar" IsSelected="True"/>
                <ComboBoxItem Content="Rukovodilac"/>
            </ComboBox>

            <CheckBox x:Name="chkAktivan" Content="Aktivan" Margin="0,10,0,0" IsChecked="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Otkaži" Padding="15,8" Margin="0,0,10,0"
                    Background="#95A5A6" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnOtkazi_Click"/>
            <Button Content="Sačuvaj" Padding="15,8"
                    Background="#27AE60" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>