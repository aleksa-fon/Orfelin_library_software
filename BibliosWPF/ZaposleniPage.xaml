<Page x:Class="Orfelin.WPF.ZaposleniPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Zaposleni" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Zaposleni" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <Button x:Name="btnDodaj" Content="+ Dodaj zaposlenog" HorizontalAlignment="Right"
                    Background="#27AE60" Foreground="White" Padding="15,8"
                    BorderThickness="0" Cursor="Hand" Click="btnDodaj_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <TextBox x:Name="txtPretraga" Height="35" Padding="10,8" FontSize="13"
                     BorderBrush="#BDC3C7" BorderThickness="1"
                     TextChanged="txtPretraga_TextChanged"/>
            <TextBlock Text="Pretraži zaposlene..." Foreground="#BDC3C7" FontSize="13"
                       Padding="12,8" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=txtPretraga}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <DataGrid x:Name="dgZaposleni" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  BorderBrush="#BDC3C7" BorderThickness="1"
                  RowBackground="White" AlternatingRowBackground="#F9F9F9"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime" Binding="{Binding Ime}" Width="120"/>
                <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime}" Width="120"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Uloga" Binding="{Binding Uloga}" Width="120"/>
                <DataGridCheckBoxColumn Header="Aktivan" Binding="{Binding Aktivan}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnIzmeni" Content="✏️ Izmeni" Padding="15,8" Margin="0,0,10,0"
                    Background="#F39C12" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnIzmeni_Click"/>
            <Button x:Name="btnObrisi" Content="🗑️ Obriši" Padding="15,8"
                    Background="#E74C3C" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="btnObrisi_Click"/>
        </StackPanel>
    </Grid>
</Page>